# Copy the lines you need into your shell or a local .env (never commit it).
# Judge / ranker (TypeSafe Jev). One of: typesafe | openrouter | vercel | opencode | mock
REPLY_JUDGE=typesafe
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# Drafter. One of: anthropic | deepseek | openrouter | openai | mock
REPLY_DRAFTER=anthropic
ANTHROPIC_API_KEY=
# DRAFT_MODEL=claude-opus-5
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# Price overrides for cost reporting (USD per million tokens)
# DRAFT_PRICE_IN=
# DRAFT_PRICE_OUT=

# Who you are (used in the drafting prompt and to skip your own messages)
OWNER_NAME=정회광
OWNER_EMAIL=
OWNER_STYLE=정중하지만 짧게. 존댓말. 과한 이모지 없음.

# Channels
GOOGLE_CLIENT_SECRET_FILE=
YOUTUBE_CHANNEL_ID=
IG_ACCESS_TOKEN=
# IG_API_VERSION=v24.0
